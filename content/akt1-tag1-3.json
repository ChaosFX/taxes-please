  "rules": [
    {
      "id": "R1",
      "day": 1,
      "title": "Werbungskosten",
      "text": "Werbungskosten sind Aufwendungen zur Erwerbung, Sicherung oder Erhaltung der Einnahmen. Fehlt der Zusammenhang mit dem Beruf, gibt es keinen Abzug.",
      "source": "§ 16 Abs. 1 erster Satz EStG",
      "sourceUrl": "https://www.ris.bka.gv.at/Dokumente/Bundesnormen/NOR40274823/NOR40274823.html"
    },
    {
      "id": "R2",
      "day": 1,
      "title": "Arbeitsmittel",
      "text": "Ausgaben für Arbeitsmittel wie Werkzeug und Berufskleidung sind Werbungskosten.",
      "source": "§ 16 Abs. 1 Z 7 EStG",
      "sourceUrl": "https://www.ris.bka.gv.at/Dokumente/Bundesnormen/NOR40274823/NOR40274823.html"
    },
    {
      "id": "R3",
      "day": 2,
      "title": "Kosten der Lebensführung",
      "text": "Aufwendungen für die Lebensführung sind nicht abzugsfähig, auch wenn sie den Beruf fördern.",
      "source": "§ 20 Abs. 1 Z 2 lit. a EStG",
      "sourceUrl": "https://ris.bka.gv.at/eli/bgbl/1988/400/P20/NOR40248368"
    },
    {
      "id": "R4",
      "day": 2,
      "title": "Kleidung",
      "text": "Bürgerliche Kleidung ist nicht abzugsfähig, auch wenn sie nur im Beruf getragen wird. Typische Berufskleidung ist abzugsfähig.",
      "source": "LStR Rz 322",
      "sourceUrl": "https://linda.lindeverlag.at/Dokument/76545_5___9___2/"
    },
    {
      "id": "R5",
      "day": 2,
      "title": "Fachliteratur",
      "text": "Fachliteratur mit beruflichem Bezug ist absetzbar. Allgemein bildende Werke, Lexika und Tageszeitungen sind es nicht.",
      "source": "LStR Rz 383e, Rz 394",
      "sourceUrl": "https://linda.lindeverlag.at/Dokument/76545_5___9___21___5/"
    },
    {
      "id": "R6",
      "day": 3,
      "title": "Persönliche Steuerpflicht",
      "text": "Wer im Inland einen Wohnsitz oder den gewöhnlichen Aufenthalt hat, ist unbeschränkt steuerpflichtig, und zwar mit allen in- und ausländischen Einkünften. Wer beides nicht hat, ist beschränkt steuerpflichtig. Einen Wohnsitz hat, wer eine Wohnung so innehat, dass er sie beibehalten und benutzen wird. Ein Aufenthalt im Inland von mehr als sechs Monaten führt jedenfalls zum gewöhnlichen Aufenthalt.",
      "source": "§ 1 Abs. 2 und 3 EStG, § 26 BAO",
      "sourceUrl": "https://www.ris.bka.gv.at/eli/bgbl/1988/400/P1/NOR40274820"
    },
    {
      "id": "R7",
      "day": 3,
      "title": "Ergänzungsersuchen",
      "text": "Das Finanzamt prüft die Erklärungen. Sind Angaben unvollständig oder bestehen Zweifel, fordert es den Abgabepflichtigen schriftlich zur Ergänzung auf.",
      "source": "§ 161 Abs. 1 BAO",
      "sourceUrl": "https://www.jusline.at/gesetz/bao/paragraf/161.pdf"
    }
  ],
